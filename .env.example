# Optional environment variables — none are required to run.
# Copy to .env only if you want to override defaults locally (the app reads
# real env vars from the platform, e.g. Render, without needing a .env file).

# HTTP port the server listens on (Render provides this automatically).
# PORT=3000

# Additional allowed CORS origins, comma-separated.
# Default: same-origin only (the app serves its own frontend).
# CORS_ORIGIN=https://example.com,https://app.example.com

# Game tuning
# TURN_DURATION=60        # seconds per drawing turn
# TOTAL_ROUNDS=3          # rounds per game
# WORD_CHOICE_TIME=15     # seconds the drawer has to pick a word
